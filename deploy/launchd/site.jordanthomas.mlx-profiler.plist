<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs profiler.py (mlx_lm.server + /metrics) as a login agent on the Mac mini.

  Install:
    cp deploy/launchd/site.jordanthomas.mlx-profiler.plist ~/Library/LaunchAgents/
    # edit the --model line below for the model you want served
    launchctl load  ~/Library/LaunchAgents/site.jordanthomas.mlx-profiler.plist
    launchctl start site.jordanthomas.mlx-profiler

  Reload after editing:
    launchctl unload ~/Library/LaunchAgents/site.jordanthomas.mlx-profiler.plist
    launchctl load   ~/Library/LaunchAgents/site.jordanthomas.mlx-profiler.plist

  Logs: ~/Library/Logs/mlx-profiler.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>site.jordanthomas.mlx-profiler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jordanthomas/Developer/homelab/mlx-memory-profiler/.venv/bin/python</string>
        <string>/Users/jordanthomas/Developer/homelab/mlx-memory-profiler/profiler.py</string>
        <string>--metrics-host</string>
        <string>0.0.0.0</string>
        <string>--metrics-port</string>
        <string>9105</string>
        <string>--sample-interval</string>
        <string>2</string>
        <!-- everything below is passed straight through to mlx_lm.server -->
        <string>--model</string>
        <string>mlx-community/Qwen3.5-9B-6bit</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8080</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jordanthomas/Developer/homelab/mlx-memory-profiler</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- footprint / vm_stat / sysctl live in /usr/bin and /usr/sbin -->
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jordanthomas/Library/Logs/mlx-profiler.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jordanthomas/Library/Logs/mlx-profiler.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
